<idea-plugin>
    <vendor email="fabius.dieciscudi@protonmail.com"
            url="https://github.com/fabiusdieciscudi/idea-echo-plugin">Fabius Dieciscudi</vendor>

    <description><![CDATA[
    ]]></description>

    <change-notes><![CDATA[<p>Initial version.</p>]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <resource-bundle>messages.EchoBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="name.fabius10scudi.ideaecho.EchoPlugin"/>

        <!-- With TeXiFy installed, .tex is the "Latex" language (case-sensitive!). -->
        <annotator language="Latex"
                   implementationClass="name.fabius10scudi.ideaecho.EchoAnnotator"/>

        <!-- Without TeXiFy, .tex is plain text; also covers the runIde sandbox. -->
        <annotator language="TEXT"
                   implementationClass="name.fabius10scudi.ideaecho.EchoAnnotator"/>

        <toolWindow factoryClass="name.fabius10scudi.ideaecho.EchoToolWindowFactory"
                    id="Idea Echo"
                    anchor="right"
                    secondary="true"
                    canCloseContents="false"/>

        <projectConfigurable parentId="tools"
                             id="name.fabius10scudi.ideaecho.settings"
                             displayName="Idea Echo"
                             instance="name.fabius10scudi.ideaecho.EchoConfigurable"/>
    </extensions>
</idea-plugin>
